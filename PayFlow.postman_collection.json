{
  "info": {
    "_postman_id": "9a12e3bc-7f41-482a-a92c-88574c83e100",
    "name": "PayFlow Enterprise Microservices API",
    "description": "PayFlow .NET 9 Dağıtık Mikroservis Platformu: JWT Auth, PostgreSQL, Redis Cache-Aside, Outbox Pattern, RabbitMQ ve Seq Tracing Test Koleksiyonu",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "last_order_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Sistem & Sağlık (Health)",
      "item": [
        {
          "name": "API Gateway Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "pm-test-health-001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Kimlik & Güvenlik (JWT Auth)",
      "item": [
        {
          "name": "Login - Customer (Müşteri Girişi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "    console.log('Customer JWT Token kaydedildi:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "pm-auth-customer-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@payflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Admin (Yönetici Girişi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "    console.log('Admin JWT Token kaydedildi:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "pm-auth-admin-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@payflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Ürün Kataloğu (Redis Cache-Aside)",
      "item": [
        {
          "name": "Ürünleri Listele (1. İstek DB, 2. İstek Redis)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "pm-catalog-get-001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog"]
            }
          }
        },
        {
          "name": "Yeni Ürün Ekle (Cache Invalidation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PayFlow Premium POS Terminali\",\n  \"description\": \"Yüksek hızlı NFC ve Çip okuyuculu yeni nesil akıllı ödeme terminali\",\n  \"price\": 14999.00,\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sipariş & Outbox (CQRS & Event-Driven)",
      "item": [
        {
          "name": "Sipariş Oluştur (JWT Bearer Token ile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.orderId) {",
                  "    pm.collectionVariables.set('last_order_id', jsonData.orderId);",
                  "    console.log('Oluşturulan OrderId:', jsonData.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "pm-order-create-1001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"22222222-2222-2222-2222-222222222222\",\n  \"customerEmail\": \"customer@payflow.com\",\n  \"street\": \"Büyükdere Cad. No: 199\",\n  \"city\": \"İstanbul\",\n  \"country\": \"Türkiye\",\n  \"zipCode\": \"34394\",\n  \"items\": [\n    {\n      \"productId\": \"11111111-1111-1111-1111-111111111101\",\n      \"productName\": \"PayFlow POS Terminal Pro\",\n      \"unitPrice\": 8500.00,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Sipariş Durumunu Sorgula (Paid olduğunu gör)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{last_order_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{last_order_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Ödeme & SOAP Banka Sonucu",
      "item": [
        {
          "name": "Ödeme Kayıtlarını İncele (Idempotency Kontrolü)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            }
          }
        }
      ]
    }
  ]
}
